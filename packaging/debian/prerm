#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop proxywall.service >/dev/null || true
    fi
    # Removing the package must never leave the machine locked behind the
    # kill switch: drop the firewall table and its boot-time copy.
    rm -f /var/lib/proxywall/boot.nft
    if command -v nft >/dev/null 2>&1; then
        printf 'table inet proxywall\ndelete table inet proxywall\n' | nft -f - >/dev/null 2>&1 || true
    fi
fi

find /usr/lib/proxywall -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true

exit 0
